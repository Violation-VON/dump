{
  "license": "GPL-3.0-only",
  "tasks": {
    "data": "deno run --allow-read --allow-write=src/data --v8-flags=--max-old-space-size=6144 scripts/data.ts",
    "bundle": "vite build",
    "pages": "deno run --allow-read=src/data,dist,VERSION --allow-write=dist --allow-env=GITHUB_SHA,GITHUB_REPOSITORY,SITE_URL,INDEXNOW_KEY --v8-flags=--max-old-space-size=6144 scripts/pages.ts",
    "indexnow": "deno run --allow-read=dist --allow-net=api.indexnow.org --allow-env=VERCEL_ENV,INDEXNOW_KEY scripts/indexnow.ts",
    "build": {
      "command": "deno task bundle && deno task pages",
      "dependencies": ["data"]
    },
    "preview": "vite preview"
  },
  "nodeModulesDir": "auto",
  "imports": {
    "hash-wasm": "npm:hash-wasm@^4.12.0",
    "html-minifier-terser": "npm:html-minifier-terser@^7.2.0",
    "mustache": "npm:mustache@^4.2.0",
    "@tailwindcss/vite": "npm:@tailwindcss/vite@^4.3.3",
    "tailwindcss": "npm:tailwindcss@^4.3.3",
    "vite": "npm:vite@^8.3.5"
  },
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "deno.ns"],
    "types": ["vite/client"]
  },
  "fmt": {
    "exclude": ["dist/", "src/data/"]
  },
  "lint": {
    "exclude": ["dist/", "src/data/"]
  }
}
