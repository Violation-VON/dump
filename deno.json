{
  "license": "GPL-3.0-only",
  "tasks": {
    "data": "deno run --allow-read --allow-write=src/data --allow-env=DUMP --v8-flags=--max-old-space-size=6144 scripts/data.ts",
    "dev": "vite",
    "bundle": "vite build",
    "build": {
      "command": "deno task bundle",
      "dependencies": ["data"]
    },
    "preview": "vite preview"
  },
  "nodeModulesDir": "auto",
  "imports": {
    "@tailwindcss/vite": "npm:@tailwindcss/vite@^4.3.3",
    "tailwindcss": "npm:tailwindcss@^4.3.3",
    "vite": "npm:vite@^8.3.5"
  },
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "deno.ns"],
    "types": ["vite/client", "./src/env.d.ts"]
  },
  "fmt": {
    "exclude": ["dist/", "src/data/"]
  },
  "lint": {
    "exclude": ["dist/", "src/data/"]
  }
}
